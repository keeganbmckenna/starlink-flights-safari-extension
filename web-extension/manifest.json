{
  "manifest_version": 3,
  "name": "Starlink Column for Google Flights",
  "version": "1.0",
  "description": "Adds a Starlink Wi-Fi status badge to each result on Google Flights, based on publicly reported airline rollout status.",
  "icons": {
    "16": "images/icon-16.png",
    "32": "images/icon-32.png",
    "48": "images/icon-48.png",
    "128": "images/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "images/icon-16.png",
      "32": "images/icon-32.png",
      "48": "images/icon-48.png",
      "128": "images/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/travel/flights*",
        "https://www.google.com/flights*"
      ],
      "js": ["data/starlink-airlines.js", "content-script.js"],
      "css": ["content-style.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "host_permissions": [
    "https://www.google.com/travel/flights*",
    "https://www.google.com/flights*"
  ]
}
